<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <!--
    Entitlements para el hardened runtime (requisito de notarización).
    - allow-jit + allow-unsigned-executable-memory: los necesita el motor V8
      de Electron/Chromium.
    - disable-library-validation + allow-dyld-environment-variables: los
      necesita el agente PyInstaller (carga dylibs propios — lxml, OpenSSL —
      y su bootstrap usa variables dyld).
  -->
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
  </dict>
</plist>
