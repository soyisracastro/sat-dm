{
  "name": "todoconta-desktop",
  "productName": "TodoConta",
  "version": "1.0.4",
  "private": true,
  "description": "TodoConta Desktop — app de escritorio (Electron) sobre el agente SAT (Python).",
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "build:agent": "cd .. && pyinstaller packaging/sat-agent.spec --noconfirm --clean --distpath packaging/dist --workpath packaging/build",
    "build:ui": "cd ../ui && pnpm install --frozen-lockfile && pnpm build",
    "build:installer": "electron-builder",
    "build": "pnpm build:agent && pnpm build:ui && pnpm build:installer"
  },
  "dependencies": {
    "electron-log": "^5.2.0",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "pnpm": {
    "//": "pnpm bloquea postinstall por seguridad; autorizamos solo los que requieren binarios.",
    "onlyBuiltDependencies": [
      "electron",
      "electron-builder",
      "esbuild"
    ]
  }
}
