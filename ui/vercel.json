{
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://api.todoconta.com/api/:path*" },
    { "source": "/desktop/:path*", "destination": "https://api.todoconta.com/desktop/:path*" },
    { "source": "/auth/:path*", "destination": "https://api.todoconta.com/auth/:path*" },
    { "source": "/planes", "destination": "https://api.todoconta.com/planes" },
    { "source": "/cuenta/:path*", "destination": "https://api.todoconta.com/cuenta/:path*" }
  ]
}
